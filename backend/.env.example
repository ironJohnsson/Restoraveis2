# Execução local do backend (npm start). Copie para ".env"; todas são opcionais.
PORT=5000

# Sem DATABASE_URL a API usa SQLite em backend/data/database.sqlite (zero configuração).
# Para usar PostgreSQL + PostGIS:
# DATABASE_URL=postgres://topsis_user:topsis_password@localhost:5432/topsis_db

# Em branco: segredo aleatório gerado e salvo em backend/data/.jwt_secret
JWT_SECRET=
JWT_EXPIRES_IN=8h

SEED_SENHA_PADRAO=123456
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
