{
  "name": "plataforma-energia-renovavel-backend",
  "version": "1.1.0",
  "description": "API RESTful e Motor TOPSIS para Mensuração Multicritério de Vulnerabilidade Social Energética",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "docs:api": "node src/docs/exportar.js"
  },
  "keywords": [
    "topsis",
    "energia-renovavel",
    "vulnerabilidade-social",
    "ods7",
    "api-rest"
  ],
  "author": "Equipe de Desenvolvimento - Plataforma TOPSIS",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "sql.js": "^1.14.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/helpers/env.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    },
    "testTimeout": 20000
  }
}
