{
  "openapi": "3.0.0",
  "info": {
    "title": "API - Plataforma de Energia Renovável com TOPSIS",
    "description": "Documentação formal da API RESTful para Mensuração Multicritério de Vulnerabilidade Social Energética, em conformidade com as normas ISO/IEC 12207 e ISO/IEC 25010.",
    "version": "1.0.0",
    "contact": {
      "name": "Prof. Me. Celso Barreto & Equipe de Desenvolvimento",
      "url": "https://senaiba.my.canva.site/roteiro1"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Servidor de Desenvolvimento Local"
    }
  ],
  "paths": {
    "/api/status": {
      "get": {
        "summary": "Health Check do Sistema",
        "description": "Retorna o status operacional da API e metadados de versão.",
        "responses": {
          "200": { "description": "API operando normalmente." }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Autenticação de Usuário",
        "description": "Gera token Bearer JWT após validação das credenciais por hash bcrypt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "admin@topsis.gov.br" },
                  "senha": { "type": "string", "example": "123456" }
                },
                "required": ["email", "senha"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Autenticado com sucesso. Retorna token JWT." },
          "401": { "description": "Credenciais inválidas." }
        }
      }
    },
    "/api/municipios": {
      "get": {
        "summary": "Listar Municípios",
        "description": "Recupera todos os municípios cadastrados acompanhados dos valores de seus indicadores.",
        "parameters": [
          { "name": "uf", "in": "query", "schema": { "type": "string" }, "description": "Filtrar por UF (ex: BA)" },
          { "name": "busca", "in": "query", "schema": { "type": "string" }, "description": "Termo de busca para nome" }
        ],
        "responses": {
          "200": { "description": "Lista de municípios recuperada com sucesso." }
        }
      },
      "post": {
        "summary": "Cadastrar Novo Município",
        "description": "Insere um novo município e popula os valores da matriz de decisão.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Sobral" },
                  "uf": { "type": "string", "example": "CE" },
                  "populacao": { "type": "integer", "example": 210000 },
                  "idh": { "type": "number", "example": 0.714 },
                  "latitude": { "type": "number", "example": -3.6894 },
                  "longitude": { "type": "number", "example": -40.3486 },
                  "indicadores": {
                    "type": "object",
                    "example": { "C1": 4.5, "C2": 2.2, "C3": 1150, "C4": 0.72, "C5": 5.9, "C6": 16.0, "C7": 8 }
                  }
                },
                "required": ["nome", "uf", "latitude", "longitude"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Município criado com sucesso." },
          "409": { "description": "Município já existente." }
        }
      }
    },
    "/api/criterios": {
      "get": {
        "summary": "Listar Critérios e Indicadores",
        "description": "Lista os critérios cadastrados com tipos (benefício/custo), pesos e fontes.",
        "responses": {
          "200": { "description": "Critérios retornados com sucesso." }
        }
      }
    },
    "/api/criterios/pesos": {
      "put": {
        "summary": "Atualizar Pesos dos Critérios",
        "description": "Atualiza a distribuição de pesos para simulações TOPSIS.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": { "pesos": { "C1": 0.20, "C2": 0.20, "C3": 0.15, "C4": 0.25, "C5": 0.20, "C6": 0.0, "C7": 0.0 } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Pesos atualizados com sucesso." }
        }
      }
    },
    "/api/topsis/executar": {
      "post": {
        "summary": "Executar Processamento TOPSIS",
        "description": "Executa o algoritmo multicritério TOPSIS com normalização vetorial e retorna o ranking ordenado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "titulo": { "type": "string", "example": "Simulação Prioridade Solar 2026" },
                  "salvarSimulacao": { "type": "boolean", "example": true },
                  "pesosPersonalizados": {
                    "type": "object",
                    "example": { "C1": 0.20, "C2": 0.20, "C3": 0.15, "C4": 0.25, "C5": 0.20 }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Ranking calculado e retornado com métricas completas." }
        }
      }
    },
    "/api/topsis/simulacoes": {
      "get": {
        "summary": "Histórico de Simulações",
        "description": "Retorna o histórico de todas as simulações TOPSIS executadas.",
        "responses": {
          "200": { "description": "Histórico recuperado com sucesso." }
        }
      }
    },
    "/api/relatorios/{id}/csv": {
      "get": {
        "summary": "Exportar Resultados em CSV",
        "description": "Gera arquivo tabular formatado para planilhas eletrônicas.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Arquivo CSV retornado." }
        }
      }
    },
    "/api/relatorios/{id}/pdf": {
      "get": {
        "summary": "Exportar Relatório Executivo em PDF",
        "description": "Gera documento analítico com recomendações executivas e tabela diagramada.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Arquivo PDF retornado." }
        }
      }
    }
  }
}
