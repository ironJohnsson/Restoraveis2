# Copie este arquivo para ".env" (na raiz do projeto) para personalizar o Docker Compose.
# Todas as variáveis são opcionais.

# Senha do usuário do PostgreSQL (use apenas letras, números, "-" e "_")
POSTGRES_PASSWORD=topsis_password

# Segredo de assinatura dos tokens JWT. Em branco, a API gera um segredo aleatório
# na primeira execução e o guarda no volume de dados.
JWT_SECRET=

# Senha inicial das três contas de demonstração (admin, pesquisador e gestor).
# Troque-a pelo próprio sistema (ícone de chave) logo após o primeiro acesso.
SEED_SENHA_PADRAO=123456

# Origens autorizadas a chamar a API a partir de outro domínio (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000
